# --- Required ---
# Postgres connection string.
# Local dev:  postgresql://health:health@localhost:5432/health  (see docker-compose.yml)
# Production: Neon connection string from https://console.neon.tech
DATABASE_URL=postgresql://health:health@localhost:5432/health

# Secret for auth cookies/tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app (no trailing slash)
APP_URL=http://localhost:3000

# Extra origins allowed by CSRF protection (comma-separated), e.g. dev ports.
# Production usually needs none — Vercel's https origin is covered by APP_URL.
TRUSTED_ORIGINS=

# --- Google sign-in (required; the only login method) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application):
#   Authorized JavaScript origins: APP_URL
#   Authorized redirect URI:       APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact whitelist of emails allowed to sign in (comma-separated, case-insensitive).
# Applied server-side to every sign-in, sign-up, and account link. Removing an
# email here blocks its next sign-in.
ALLOWED_EMAILS=

# IANA timezone used for all scheduling and date display (default Asia/Kuala_Lumpur).
# Zoneless datetime-local inputs are interpreted as wall time in this zone, so it
# must NOT rely on the server's zone (UTC on Vercel).
APP_TIMEZONE=Asia/Kuala_Lumpur

# The same zone, for the browser. Client components render and seed dates too (the
# charts, the header, every create form's default), and only NEXT_PUBLIC_* reaches
# them. Set BOTH to the same value, then rebuild — Next inlines it at build time.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kuala_Lumpur

# --- AI (optional; enables screenshot reading + AI reviews) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# --- Seeding (optional; read only by `pnpm db:seed`) ---
# Starter accounts: one admin, one member, one trainer — the roles the app
# ships with. Each email must also be in ALLOWED_EMAILS.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_MEMBER_NAME=
SEED_MEMBER_EMAIL=
SEED_TRAINER_NAME=
SEED_TRAINER_EMAIL=
