# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent/tooling workspace state — never part of the repo
.commandcode/
.mcp.json
.impeccable/

# private ops journal some keep next to a working clone
QA_ISSUES.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template IS the documentation — keep it tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
